{
	"livePreview.serverRoot": "doc/public_html",
	"latex-workshop.latex.outDir": "%WORKSPACE_FOLDER%/docs/",
	"latex-workshop.latex.auxDir":"%DIR%",
	"latex-workshop.latex.tools": [
		{
			"name": "latexmk",
			"command": "latexmk",
			"args": [
				"-synctex=1",
				"-interaction=nonstopmode",
				"-file-line-error",
				"-pdf",
				"-jobname=crane-dynamics-simulator-maths-and-physics",
				"-outdir=%OUTDIR%",
				"--aux-directory=%AUXDIR%",
				"%DOC%"
			],
		}
	],
	"[matlab]": {
		"files.trimTrailingWhitespace": true,
		"editor.insertSpaces": true,
		"editor.tabSize": 4,
		"editor.detectIndentation": false,
	},
	"[powershell]": {
		"files.trimTrailingWhitespace": true,
		"editor.insertSpaces": false,
		"editor.tabSize": 4,
		"editor.detectIndentation": false,
	},
	"[shellscript]": {
		"files.trimTrailingWhitespace": true,
		"editor.insertSpaces": false,
		"editor.tabSize": 4,
		"editor.detectIndentation": false,
	},
	"[cmake]": {
		"files.trimTrailingWhitespace": true,
		"editor.insertSpaces": false,
		"editor.tabSize": 4,
		"editor.detectIndentation": false,
	},
	"[cpp]": {
		"files.trimTrailingWhitespace": true,
		"editor.insertSpaces": false,
		"editor.tabSize": 4,
		"editor.detectIndentation": false,
	},
	"[markdown]": {
		"files.trimTrailingWhitespace": true,
	}
}